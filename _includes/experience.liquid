<div class="experience-list">
  {% for experience in site.data.experience %}
    <section class="experience-entry" aria-labelledby="experience-{{ forloop.index }}">
      <div class="experience-logo">
        <img src="{{ experience.logo | relative_url }}" alt="{{ experience.organization | escape }} logo" width="112" height="80">
      </div>
      <div class="experience-details">
        <h2 id="experience-{{ forloop.index }}">{{ experience.role }}</h2>
        <p class="experience-organization">{{ experience.organization }} <span class="experience-type">&middot; {{ experience.employment_type }}</span></p>
        {% if experience.reporting_to %}
          <p class="experience-reporting">Reporting directly to <a href="{{ experience.reporting_url | escape }}" target="_blank" rel="noopener noreferrer">@{{ experience.reporting_to }}</a> ({{ experience.reporting_title }}).</p>
        {% endif %}
        <p class="experience-dates">
          <time datetime="{{ experience.start_date }}">{{ experience.start_label }}</time> &ndash;
          {% if experience.end_date %}<time datetime="{{ experience.end_date }}">{{ experience.end_label }}</time>{% else %}{{ experience.end_label }}{% endif %}
        </p>
        <p class="experience-description">{{ experience.description }}</p>
      </div>
    </section>
  {% endfor %}
</div>
